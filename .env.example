# Copy to .env and fill in. NEVER commit .env (it is git-ignored and docker-ignored).

# --- MLflow on DagsHub (training, registry, fetch_model.py) ---
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>

# --- Docker Compose (Task 6.3) ---
POSTGRES_DB=visionguard
POSTGRES_USER=visionguard
# Use letters/digits only (it is placed inside the database URL)
POSTGRES_PASSWORD=<long-random-password>
# Required header X-API-Key for POST /api/predict
API_KEY=<long-random-key>
SECRET_KEY=<long-random-secret>
# Optional overrides
# THRESHOLD=0.66
# MAX_UPLOAD_MB=5
# WEB_PORT=8000
